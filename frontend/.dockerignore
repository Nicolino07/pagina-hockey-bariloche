# Dependencias y artefactos de build (se instalan/generan dentro de la imagen)
node_modules
dist
dist-ssr
*.tsbuildinfo

# Control de versiones
.git
.gitignore

# Docs
README.md

# Variables de entorno: se pasan como build args / env de compose.
# .env.example sí se conserva como referencia.
.env
.env.*
!.env.example

# Archivos propios de Docker (no hacen falta dentro de la imagen)
Dockerfile
.dockerignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / SO
.vscode
.idea
.DS_Store

# NOTA: nginx.conf NO se ignora: la etapa `production` lo copia
# con `COPY nginx.conf /etc/nginx/conf.d/default.conf`.
